# Server-only credential used by both Nano Banana and Veo.
# Never prefix the key with NEXT_PUBLIC.
GEMINI_API_KEY=
# Videos always use Veo 3.1 Fast; no model variable is needed.
# Images use the stable Nano Banana model, gemini-2.5-flash-image.
VIDEO_MAX_JOBS_PER_SESSION=20
# Optional free video demo (images still require a Gemini key):
# VIDEO_PROVIDER=mock
